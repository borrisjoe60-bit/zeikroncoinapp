# Set these in the backend host's encrypted environment settings. Never commit real values.
DATABASE_URL=
JWT_SECRET=
FRONTEND_URL=https://zeikroncoinapp.vercel.app
COINBASE_CLIENT_ID=
COINBASE_CLIENT_SECRET=
# Base64-encoded 32-byte random key for AES-256-GCM token encryption.
COINBASE_TOKEN_ENCRYPTION_KEY=
# Exact HTTPS callback registered in Coinbase, including path.
COINBASE_REDIRECT_URI=
NODE_ENV=production
